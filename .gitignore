node_modules/
vendor/
.DS_Store
.env

# Build output (generated by `npm run build` in build_tools/ or by CI)
/dist/
/public_html/wp-content/themes/joevernazza/assets/js/
/public_html/wp-content/themes/joevernazza/assets/css/main.css
/public_html/wp-content/mu-plugins/joevernazza/blocks/

# WordPress: core is tracked and deployed (updated on purpose: commit the new
# version, then push). Per-environment files are not: wp-config.php, Docker's
# config, .htaccess (WordPress writes it), uploads, and third-party
# plugins/themes. In wp-content only our code and the "silence" index.php
# files are tracked.
/public_html/wp-config.php
/public_html/wp-config-docker.php
/public_html/.htaccess
/public_html/wp-content/*
!/public_html/wp-content/index.php
!/public_html/wp-content/plugins/
/public_html/wp-content/plugins/*
!/public_html/wp-content/plugins/index.php
!/public_html/wp-content/themes/
/public_html/wp-content/themes/*
!/public_html/wp-content/themes/index.php
!/public_html/wp-content/themes/joevernazza/
!/public_html/wp-content/mu-plugins/
/public_html/wp-content/mu-plugins/*
!/public_html/wp-content/mu-plugins/joevernazza.php
!/public_html/wp-content/mu-plugins/joevernazza/

# Database exports from scripts/pull-db.sh
/db/
