{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1400px",
			"wideSize": "1400px"
		},
		"color": {
			"custom": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "primary",
					"name": "Primary",
					"color": "#1e293b"
				},
				{
					"slug": "secondary",
					"name": "Secondary",
					"color": "#475569"
				},
				{
					"slug": "tertiary",
					"name": "Tertiary",
					"color": "#64748b"
				},
				{
					"slug": "accent",
					"name": "Accent",
					"color": "#cbd5e1"
				},
				{
					"slug": "light",
					"name": "Light",
					"color": "#f8fafc"
				},
				{
					"slug": "white",
					"name": "White",
					"color": "#ffffff"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "rubik",
					"name": "Rubik",
					"fontFamily": "Rubik, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Rubik",
							"fontStyle": "normal",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/rubik/rubik-latin-wght-normal.woff2"
							]
						},
						{
							"fontFamily": "Rubik",
							"fontStyle": "italic",
							"fontWeight": "300 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/rubik/rubik-latin-wght-italic.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "Extra small",
					"size": "12px",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "16px",
					"fluid": {
						"min": "14px",
						"max": "16px"
					}
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "18px",
					"fluid": {
						"min": "16px",
						"max": "18px"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "20px",
					"fluid": {
						"min": "16px",
						"max": "20px"
					}
				},
				{
					"slug": "x-large",
					"name": "Extra large",
					"size": "24px",
					"fluid": {
						"min": "20px",
						"max": "24px"
					}
				},
				{
					"slug": "xx-large",
					"name": "2X large",
					"size": "32px",
					"fluid": {
						"min": "24px",
						"max": "32px"
					}
				},
				{
					"slug": "huge",
					"name": "Huge",
					"size": "50px",
					"fluid": {
						"min": "36px",
						"max": "50px"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"rem",
				"%",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"name": "XS",
					"size": "8px"
				},
				{
					"slug": "20",
					"name": "S",
					"size": "16px"
				},
				{
					"slug": "30",
					"name": "M",
					"size": "20px"
				},
				{
					"slug": "40",
					"name": "L",
					"size": "24px"
				},
				{
					"slug": "50",
					"name": "XL",
					"size": "40px"
				},
				{
					"slug": "60",
					"name": "XXL",
					"size": "60px"
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|light",
			"text": "var:preset|color|secondary"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|10",
			"padding": {
				"left": "var:preset|spacing|30",
				"right": "var:preset|spacing|30"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|rubik",
			"fontSize": "var:preset|font-size|small",
			"lineHeight": "1.4"
		},
		"elements": {
			"heading": {
				"color": {
					"text": "var:preset|color|secondary"
				},
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h1": {
				"color": {
					"text": "var:preset|color|primary"
				},
				"typography": {
					"fontSize": "var:preset|font-size|huge",
					"lineHeight": "1"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large"
				},
				"spacing": {
					"margin": {
						"bottom": "var:preset|spacing|20"
					}
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium"
				},
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|20"
					}
				}
			},
			"link": {
				"color": {
					"text": "currentColor"
				},
				":hover": {
					"typography": {
						"textDecoration": "none"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var:preset|color|primary",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|primary",
					"text": "var:preset|color|white"
				},
				"border": {
					"radius": "4px"
				},
				"typography": {
					"fontWeight": "600"
				},
				":hover": {
					"color": {
						"background": "var:preset|color|secondary"
					}
				},
				":focus-visible": {
					"outline": {
						"color": "var:preset|color|primary",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/separator": {
				"border": {
					"color": "currentColor",
					"style": "solid",
					"width": "0 0 1px 0"
				},
				"color": {
					"text": "var:preset|color|accent"
				},
				"spacing": {
					"margin": {
						"top": "var:preset|spacing|50",
						"bottom": "var:preset|spacing|50"
					}
				}
			},
			"core/list": {
				"spacing": {
					"padding": {
						"left": "18px"
					},
					"margin": {
						"bottom": "var:preset|spacing|40"
					}
				},
				"typography": {
					"lineHeight": "1.5"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page (no title)",
			"postTypes": [
				"page"
			]
		}
	]
}
