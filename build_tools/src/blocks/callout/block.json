{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "joevernazza/callout",
	"version": "1.0.0",
	"title": "Callout",
	"category": "design",
	"icon": "megaphone",
	"description": "A highlighted box with a heading and any content inside. Example of a dynamic block with inner blocks.",
	"keywords": [ "box", "notice", "cta" ],
	"textdomain": "joevernazza",
	"attributes": {
		"title": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"color": { "background": true, "text": true },
		"spacing": { "margin": true, "padding": true }
	},
	"example": {
		"attributes": { "title": "Get in touch" },
		"innerBlocks": [
			{ "name": "core/paragraph", "attributes": { "content": "Tell visitors what to do next." } }
		]
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
