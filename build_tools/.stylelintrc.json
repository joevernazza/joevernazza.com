{
	"extends": "@wordpress/stylelint-config/scss",
	"rules": {
		"scss/comment-no-empty": null,
		"selector-class-pattern": [
			"^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?$",
			{ "message": "Use lowercase BEM class names (block__element--modifier)" }
		]
	}
}
