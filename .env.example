# Copy to .env (git-ignored) and fill in. Used by docker-compose.yml and scripts/.

# Local database passwords (defaults shown)
DB_PASSWORD=joevernazza
DB_ROOT_PASSWORD=root

# Production SSH access, same values as the GitHub Actions secrets
SSH_USER=
SSH_HOST=
SSH_PORT=22
DEPLOY_PATH=/home/<cpanel-user>/public_html

# URLs swapped by scripts/pull-db.sh
PROD_URL=https://joevernazza.com
LOCAL_URL=http://localhost:8090
